{
    "get": {
        "summary": "returns the specified user",
        "parameters": [
            {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                    "type": "integer",
                    "description": "User ID"
                }
            }
        ],
        "responses": {
            "200": {
                "description": "success",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "../schemas/user.json"
                        }
                    }
                }
            },
            "400": {
                "description": "Bad request. Invalid user ID"
            },
            "404": {
                "description": "User not found"
            }
        }
    },
    "delete": {
        "summary": "Deletes the specified user",
        "parameters": [
            {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                    "type": "integer",
                    "description": "User ID"
                }
            }
        ],
        "responses": {
            "204": {
                "description": "User deleted successfully or does not exist"
            },
            "400": {
                "description": "Bad request. Invalid user ID"
            }
        }
    }
}
