{
    "post": {
        "summary": "Sign in into user account",
        "requestBody": {
            "required": true,
            "content": {
                "application/json": {
                    "schema": {
                        "$ref": "../schemas/loginDto.json"
                    }
                }
            }
        },
        "responses": {
            "200": {
                "description": "Successfull login",
                "headers": {
                    "Set-Cookie": {
                        "description": "Access token cookies",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "400": {
                "description": "Missing required fields"
            },
            "401": {
                "description": "Invalid credentials or user does not exist"
            },
            "500": {
                "description": "Internal server error"
            }
        }
    }
}
